</div><!-- /form-shell -->


<script>
  // Per-client pricing config — set from client setup checklist
  const OFFER_THROUGH_PROPERTY    = '{{custom_values.front_only__through_property}}'.toLowerCase() === 'yes';
  const FRONT_ONLY_POLICY         = '{{custom_values.front_only_policy}}'.toLowerCase() === 'yes';
  const OFFER_FLATS = '{{custom_values.flats}}'.toLowerCase() === 'yes';


  // Frequency config — from HL custom values
  const FREQ_COUNT    = parseInt('{{custom_values.frequency_count}}')  || 2;
  const FREQ_SCHEDULE = '{{custom_values.frequency_schedule}}'.toLowerCase(); // 'weekly' or 'monthly'
  const FREQ_NUMS     = [
    parseInt('{{custom_values.frequency_1_number}}') || 4,
    parseInt('{{custom_values.frequency_2_number}}') || 8,
    parseInt('{{custom_values.frequency_3_number}}') || 12,
  ];
  const FREQ_YEARLY_MULTIPLIERS = [
    parseFloat('{{custom_values.frequency_1_yearly_multiplier}}') || 0,
    parseFloat('{{custom_values.frequency_2_yearly_multiplier}}') || 0,
    parseFloat('{{custom_values.frequency_3_yearly_multiplier}}') || 0,
  ];
  const OFFER_ONEOFF  = '{{custom_values.service_offered__oneoff_window_cleaning}}'.toLowerCase() === 'yes';
  const FREE_WINDOW_COMBO = '{{custom_values.free_window_clean_combo}}'.toLowerCase() === 'yes';


  // Package upsell constants
  const GUTTER_PKG_OFFERED   = '{{custom_values.gutter_package_offered}}'.toLowerCase() === 'yes';
  const CON_ROOF_PKG_OFFERED = '{{custom_values.conservatory_roof_package_offered}}'.toLowerCase() === 'yes';


  const GUTTER_PKG = {
    yearlyCombined: parseFloat('{{custom_values.gutter_package__yearly_combined_gutter_clear__wash__discount}}') || 0,
    yearlyClear:    parseFloat('{{custom_values.gutter_package__yearly_gutter_clearance}}') || 0,
    yearlyGfs:      parseFloat('{{custom_values.gutter_package__yearly_gutter_fascia__soffit_wash__discount}}') || 0,
    sixMonthlyClear: parseFloat('{{custom_values.gutter_package__6_monthly_gutter_clear__discount}}') || 0,
  };


  const CON_ROOF_PKG = {
    threeMonthly: parseFloat('{{custom_values.conservatory_roof_package__3_monthly_discount}}') || 0,
    sixMonthly:   parseFloat('{{custom_values.conservatory_roof_package__6_monthly_discount}}') || 0,
  };


  // Stores selected packages { gutterPackage: null|{name, discount, price}, conRoofPackage: null|{name, discount, price} }
  const selectedPackages = { gutterPackage: null, conRoofPackage: null, gutterOneOff: null, conRoofOneOff: null };
  const CON_ROOF_MODE      = '{{custom_values.service_offered__conservatory_roof_cleaning}}'.trim().toLowerCase(); // 'fixed price', 'per panel', or 'no'
  const CON_ROOF_FIXED     = parseFloat('{{custom_values.conservatory_roof_fixed_price}}') || 0;
  const CON_ROOF_MIN       = parseFloat('{{custom_values.conservatory_roof_min}}')         || 100;
  const CON_ROOF_PER_PANEL = parseFloat('{{custom_values.conservatory_roof_per_panel}}')   || 10;
  const OFFER_INTERNAL         = '{{custom_values.service_offered__internal_window_cleaning}}'.toLowerCase() === 'yes';
  const OFFER_REGULAR_INTERNAL = '{{custom_values.service_offered__regular_internal_window_cleaning}}'.toLowerCase() === 'yes';
  const OFFER_GUTTER_CLEARANCE = '{{custom_values.service_offered__gutter_clearance}}'.toLowerCase() === 'yes';
  const OFFER_GFS              = '{{custom_values.service_offered__gutter_fascia__soffit_washing}}'.toLowerCase() === 'yes';


  // Build frequency labels e.g. "4 Weekly" or "4 Monthly"
  const FREQ_SCHEDULE_LABEL = FREQ_SCHEDULE === 'monthly' ? 'Monthly' : 'Weekly';
  const FREQ_LABELS = FREQ_NUMS.map(n => n + ' ' + FREQ_SCHEDULE_LABEL);
  const FRONT_ONLY_DISCOUNT    = parseFloat('{{custom_values.front_only_discount}}') || 25; // % discount for front-only
  const FRONT_ONLY_MIN_PRICE   = parseFloat('{{custom_values.front_only_minimum}}')  || 10; // minimum front-only price (£)


  const ONEOFF_MULTIPLIER = parseFloat('{{custom_values.oneoff_multiplier}}') || 2;
  const ONEOFF_BASE_FREQ  = parseInt('{{custom_values.frequency_to_multiply_oneoff_and_internal}}') || 1;
  const INTERNAL_BASE_FREQ          = parseInt('{{custom_values.frequency_to_multiply_oneoff_and_internal}}') || 1;
  const INTERNAL_EVERY_MULTIPLIER      = parseFloat('{{custom_values.service_offered__internal_window_cleaning__every_visit_multiplier}}')        || 1.5;
  const INTERNAL_EVERYOTHER_MULTIPLIER  = parseFloat('{{custom_values.service_offered__internal_window_cleaning__every_other_visit_multiplier}}')  || 1.5;
  const INTERNAL_ONEOFF_MULTIPLIER      = parseFloat('{{custom_values.internal_multiplier}}') || 2;


  // Returns the price for a given frequency index from the prices object
  function getFreqPrice(prices, freqNum) {
    if (freqNum === 2) return prices.freq2 || prices.freq1;
    if (freqNum === 3) return prices.freq3 || prices.freq2 || prices.freq1;
    return prices.freq1;
  }
  // Returns the RAW base price (before extensions/conservatory) for multiplier calculations
  function getRawFreqPrice(prices, freqNum) {
    if (prices.isFlat) return getFreqPrice(prices, freqNum); // flats have no add-ons
    if (freqNum === 2) return prices.rawFreq2 || prices.rawFreq1;
    if (freqNum === 3) return prices.rawFreq3 || prices.rawFreq2 || prices.rawFreq1;
    return prices.rawFreq1;
  }
  // Round up to nearest 50p (e.g. £19.20 → £19.50, £22.70 → £23.00)
  function roundUp50p(price) {
    return Math.ceil(price * 2) / 2;
  }








  // Capture source from URL hash e.g. #source=google_ads
  var source = (window.location.hash.match(/[#&]source=([^&]*)/) || [])[1] || '';


  // State
  const data = {
    fullName: '', email: '', phone: '',
    marketingConsent: [],
    propertyType: '',
    bedrooms: '',
    extension: '',
    conservatory: '',
    conservatoryRoofQuote: '',
    roofPanels: '',
    flatFloor: '',
    selectedServices: {},
    streetAddress: '',
    town: '',
    postcode: '',
    rearAccess: '',
    frontOnlyApplies: false,
    frontOnlyPrice: null,
    additionalInfo: '',
    businessName: '',
    propertyAddress: ''
  };




  // ── Resume from link ─────────────────────────────────
  (function() {
    var p = new URLSearchParams(window.location.search);
    if (!p.get('page')) return;
    // Restore contact fields
    if (p.get('name'))  { data.fullName = p.get('name');  var el = document.getElementById('fullName');  if(el) el.value = data.fullName; }
    if (p.get('email')) { data.email    = p.get('email'); var el = document.getElementById('email');     if(el) el.value = data.email; }
    if (p.get('phone')) { data.phone    = p.get('phone'); var el = document.getElementById('phone');     if(el) el.value = data.phone; }
    // Restore property data
    if (p.get('propertyType')) data.propertyType = p.get('propertyType');
    if (p.get('bedrooms'))     data.bedrooms     = p.get('bedrooms');
    if (p.get('extension'))    data.extension    = p.get('extension');
    if (p.get('conservatory')) data.conservatory = p.get('conservatory');
    if (p.get('flatFloor'))    data.flatFloor    = p.get('flatFloor');
    if (p.get('businessName')) data.businessName = p.get('businessName');
    // Navigate to correct page
    var pg = p.get('page');
    var pgNum = isNaN(pg) ? pg : Number(pg);
    if (pgNum === 8) {
      var evt = data.propertyType === 'flat' ? 'flat_details' : 'standard_details';
      showQuotePage(evt);
    } else {
      showPage(pgNum);
    }
  })();
  // ─────────────────────────────────────────────────────


  // Progress widths per step (pages 1-3 standard, page 4 custom)
  const progress = { 1: '33%', 2: '66%', 3: '100%', 4: '100%' };


  function setProgress(pct) {
    document.getElementById('progressFill').style.width = pct;
  }


  function showPage(n) {
    document.querySelectorAll('.page').forEach(p => p.classList.remove('active'));
    document.getElementById('page' + n).classList.add('active');
    const hideProgress = [5, 6, '5', '5b', '6', '6b', '6c'].includes(n) || (typeof n === 'number' && n >= 5);
    document.querySelector('.progress-bar').style.display = hideProgress ? 'none' : '';
    window.scrollTo(0, 0);
  }


  function firePageView(pageId, resumePageOverride) {
    var pId = String(pageId);
    var resumeId = resumePageOverride !== undefined ? resumePageOverride : pageId;
    fireWebhook(WH_PAGEVIEW, {
      event: 'page_view',
      pageId: pId,
      pageName: PAGE_NAMES[pId] || ('Page ' + pId),
      resumeLink: buildResumeLink(resumeId),
      fullName: data.fullName || null,
      email: data.email || null,
      phone: data.phone || null,
      propertyType: data.propertyType || null,
      bedrooms: data.bedrooms || null,
      extension: ynLabel(data.extension) || null,
      conservatory: ynLabel(data.conservatory) || null,
      flatFloor: data.flatFloor || null,
      viewedAt: new Date().toISOString()
    });
  }


  // --- Validation helpers ---
  function setError(id, msg, show) {
    const el = document.getElementById(id);
    el.textContent = msg || el.textContent;
    el.classList.toggle('visible', show);
  }
  function clearError(id) { setError(id, null, false); }


  function validateEmail(v) { return /^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(v); }


  // --- Page 1 ---
  function goTo2() {
    let ok = true;
    data.fullName = document.getElementById('fullName').value.trim();
    data.email = document.getElementById('email').value.trim();
    data.phone = document.getElementById('phone').value.trim();
    data.marketingConsent = [...document.querySelectorAll('input[name="consent"]:checked')].map(c => c.value);


    const tcChecked = document.getElementById('tcAgree').checked;


    if (!data.fullName || !data.fullName.includes(' ') || data.fullName.split(' ').filter(Boolean).length < 2) { setError('err-fullName', 'Please enter your first and last name.', true); ok = false; } else clearError('err-fullName');
    if (!validateEmail(data.email)) { setError('err-email', null, true); ok = false; } else clearError('err-email');
    if (!data.phone) { setError('err-phone', null, true); ok = false; } else clearError('err-phone');
    if (!tcChecked) {
      setError('err-tc', null, true);
      document.getElementById('tcLabel').classList.add('error-state');
      ok = false;
    } else {
      clearError('err-tc');
      document.getElementById('tcLabel').classList.remove('error-state');
    }


    if (ok) {
      fireWebhook(WH_CONTACT, {
        event: 'contact_details_submitted',
        fullName: data.fullName,
        email: data.email,
        phone: data.phone,
        submittedAt: new Date().toISOString()
      });
      setProgress('66%');
      showPage(2);
      firePageView(2);
    }
  }


  // --- Property cards ---
  function selectProperty(card, type) {
    document.querySelectorAll('.property-card').forEach(c => c.classList.remove('selected'));
    card.classList.add('selected');
    data.propertyType = type;
    clearError('err-property');
    // Brief delay so the selection animation is visible before advancing
    setTimeout(goTo3, 280);
  }


  function goTo3() {
    if (!data.propertyType) { setError('err-property', null, true); return; }


    // Commercial or large/unusual goes to page 4 directly
    if (data.propertyType === 'commercial') {
      setProgress('100%');
      showPage('4b');
      return;
    }


    if (data.propertyType === 'large-unusual') {
      setProgress('100%');
      showPage('4a');
      return;
    }


    if (data.propertyType === 'flat') {
      setProgress('100%');
      fireWebhook(WH_FLAT, { event: 'flat_selected', fullName: data.fullName, email: data.email, phone: data.phone, propertyType: data.propertyType });
      if (!OFFER_FLATS) {
        showPage('6b');
        return;
      }
      showPage(7);
      return;
    }


    setProgress('100%');
    showPage(3);
  }


  // --- Bedroom selector ---
  function selectBedroom(btn, val) {
    document.querySelectorAll('.bedroom-btn').forEach(b => b.classList.remove('selected'));
    btn.classList.add('selected');
    data.bedrooms = val;
    clearError('err-bedrooms');
  }


  // --- Yes/No ---
  const ynState = {};
  function selectYN(btn, field, val) {
    const group = btn.closest('.yn-group');
    group.querySelectorAll('.yn-btn').forEach(b => b.classList.remove('selected'));
    btn.classList.add('selected');
    data[field] = val;
    clearError('err-' + field);
    ynState[field] = val;
  }


  function showConservatoryUpsell(show) {
    const el = document.getElementById('conservatoryUpsell');
    // Only show Per Panel question — Fixed Price and No modes skip it entirely
    el.style.display = (show && CON_ROOF_MODE === 'per panel') ? '' : 'none';
    if (!show) {
      // Reset dependent fields
      data.conservatoryRoofQuote = '';
      data.roofPanels = '';
      showRoofPanels(false);
      document.querySelectorAll('#conservatoryUpsell .yn-btn').forEach(b => b.classList.remove('selected'));
      clearError('err-conservatoryRoofQuote');
      clearError('err-roofPanels');
    }
  }


  function showRoofPanels(show) {
    const el = document.getElementById('roofPanelsField');
    el.style.display = show ? '' : 'none';
    if (!show) {
      data.roofPanels = '';
      const input = document.getElementById('roofPanelCount');
      if (input) input.value = '';
      clearError('err-roofPanels');
    }
  }


  function goToCustom() {
    let ok = true;
    if (!data.bedrooms) { setError('err-bedrooms', null, true); ok = false; } else clearError('err-bedrooms');
    if (!data.extension) { setError('err-extension', null, true); ok = false; } else clearError('err-extension');
    if (!data.conservatory) { setError('err-conservatory', null, true); ok = false; } else clearError('err-conservatory');
    if (data.conservatory === 'yes' && CON_ROOF_MODE === 'per panel') {
      if (!data.conservatoryRoofQuote) { setError('err-conservatoryRoofQuote', null, true); ok = false; } else clearError('err-conservatoryRoofQuote');
      if (data.conservatoryRoofQuote === 'yes') {
        const panels = parseInt(data.roofPanels);
        if (!data.roofPanels || isNaN(panels) || panels < 1) { setError('err-roofPanels', null, true); ok = false; } else clearError('err-roofPanels');
      }
    }
    if (!ok) return;


    // Route: 6+ bedrooms → large/unusual page
    if (data.bedrooms === '6+') {
      fireWebhook(WH_SIXBED, { event: 'six_plus_bedrooms', fullName: data.fullName, email: data.email, phone: data.phone, propertyType: data.propertyType, bedrooms: data.bedrooms, extension: data.extension, conservatory: data.conservatory });
      showPage('4a');
    } else {
      // Standard flow → show quote page; WH_STANDARD fires inside showQuotePage once prices are calculated (includes full quotes)
      document.getElementById('quoteBackBtn').setAttribute('onclick', 'goBack(3)');
      showQuotePage('standard_details');
    }
  }






  // --- Back navigation ---
  function goBackFromAddress() {
    // Reset access selection
    document.querySelectorAll('#accessGrid .access-btn').forEach(b => b.classList.remove('selected'));
    document.getElementById('frontOnlyNotice').style.display = 'none';
    data.rearAccess = '';
    data.frontOnlyApplies = false;
    data.frontOnlyPrice = null;
    goBack(8);
  }


  function goBack(to) {
    const progs = { 1: '33%', 2: '66%', 3: '100%' };
    setProgress(progs[to] || '33%');
    showPage(to);
  }


  function goBackFromPage4() {
    if (data.propertyType === 'large-unusual' || data.propertyType === 'commercial') {
      setProgress('66%');
      showPage(2);
    } else if (data.propertyType === 'flat') {
      setProgress('100%');
      showPage(7);
    } else {
      setProgress('100%');
      showPage(3);
    }
  }


  // --- Flat selectors ---
  function selectFlatFloor(btn, val) {
    document.querySelectorAll('#flatFloorGrid .bedroom-btn').forEach(b => b.classList.remove('selected'));
    btn.classList.add('selected');
    data.flatFloor = val;
    clearError('err-flatFloor');
  }


  function selectFlatBedroom(btn, val) {
    document.querySelectorAll('#flatBedroomGrid .bedroom-btn').forEach(b => b.classList.remove('selected'));
    btn.classList.add('selected');
    data.bedrooms = val;
    clearError('err-flatBedrooms');
  }


  function goToFlatQuote() {
    let ok = true;
    if (!data.flatFloor) { setError('err-flatFloor', null, true); ok = false; } else clearError('err-flatFloor');
    if (!data.bedrooms) { setError('err-flatBedrooms', null, true); ok = false; } else clearError('err-flatBedrooms');
    if (!ok) return;
    fireWebhook(WH_FLAT, { event: 'flat_details', fullName: data.fullName, email: data.email, phone: data.phone, propertyType: data.propertyType, flatFloor: data.flatFloor, bedrooms: data.bedrooms });
    document.getElementById('quoteBackBtn').setAttribute('onclick', 'goBack(7)');
    showQuotePage('flat_details');
  }






  async function submitLarge() {
    let ok = true;
    data.streetAddress = document.getElementById('largeStreetAddress').value.trim();
    data.town          = document.getElementById('largeTown').value.trim();
    data.postcode      = document.getElementById('largePostcode').value.trim();


    if (!data.streetAddress) { setError('err-largeStreetAddress', null, true); ok = false; } else clearError('err-largeStreetAddress');
    if (!data.town)          { setError('err-largeTown', null, true); ok = false; } else clearError('err-largeTown');
    if (!data.postcode)      { setError('err-largePostcode', null, true); ok = false; } else clearError('err-largePostcode');
    if (!ok) return;


    fireWebhook(WH_LARGE, { event: 'large_unusual_submission', fullName: data.fullName, email: data.email, phone: data.phone, propertyType: data.propertyType, streetAddress: data.streetAddress, town: data.town, postcode: data.postcode });
    showPage(6);
  }


  async function submitCommercial() {
    let ok = true;
    data.businessName  = document.getElementById('businessName').value.trim();
    data.streetAddress = document.getElementById('bizStreetAddress').value.trim();
    data.town          = document.getElementById('bizTown').value.trim();
    data.postcode      = document.getElementById('bizPostcode').value.trim();
    const bizServices  = [...document.querySelectorAll('input[name="bizService"]:checked')].map(c => c.value);


    if (!data.businessName)  { setError('err-businessName', null, true); ok = false; }  else clearError('err-businessName');
    if (!data.streetAddress) { setError('err-bizStreetAddress', null, true); ok = false; } else clearError('err-bizStreetAddress');
    if (!data.town)          { setError('err-bizTown', null, true); ok = false; }          else clearError('err-bizTown');
    if (!data.postcode)      { setError('err-bizPostcode', null, true); ok = false; }      else clearError('err-bizPostcode');
    if (bizServices.length === 0) { setError('err-bizServices', null, true); ok = false; } else clearError('err-bizServices');
    if (!ok) return;
    fireWebhook(WH_COMMERCIAL, { event: 'commercial_submission', fullName: data.fullName, email: data.email, phone: data.phone, businessName: data.businessName, streetAddress: data.streetAddress, town: data.town, postcode: data.postcode });
    showPage(6);
  }


  function buildPayload() {
    return {
      fullName: data.fullName,
      email: data.email,
      phone: data.phone,
      marketingConsent: data.marketingConsent,
      propertyType: data.propertyType,
      bedrooms: data.bedrooms || null,
      hasExtension: data.extension || null,
      hasConservatory: data.conservatory || null,
      conservatoryRoofQuote: data.conservatoryRoofQuote || null,
      conservatoryRoofPanels: data.roofPanels || null,
      businessName: data.businessName || null,
      propertyAddress: data.propertyAddress || null,
      submittedAt: new Date().toISOString()
    };
  }




