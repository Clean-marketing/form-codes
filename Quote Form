  function buildServiceCards(prices) {
    const services = [];


    // External one-off: full freq price (base + extensions) × oneoff_multiplier
    const oneoffBase = getFreqPrice(prices, ONEOFF_BASE_FREQ) * ONEOFF_MULTIPLIER;
    const internalBase = getRawFreqPrice(prices, INTERNAL_BASE_FREQ);
    // Pre-calculate cleans-per-year using HL yearly multipliers (fallback to 52/n or 12/n)
    var isMonthlySchedule = String(FREQ_SCHEDULE).trim().toLowerCase() === 'monthly';
    var freqCleansPerYear = FREQ_NUMS.map(function(n, i) {
      var multiplier = Number(FREQ_YEARLY_MULTIPLIERS[i]);
      if (multiplier > 0) return multiplier;
      var num = Number(n);
      if (!num || num <= 0) return 0;
      var cpy = isMonthlySchedule ? (12 / num) : (52 / num);
      return isFinite(cpy) ? cpy : 0;
    });
    services.push({ id: 'windowCleaning', name: 'External Window Cleaning', price: prices.freq1, price2: prices.freq2, price3: prices.freq3 || null, oneoffBase: oneoffBase, per: 'per clean', type: 'frequency', freqCleansPerYear: freqCleansPerYear });
    if (OFFER_INTERNAL) {
      const intEvery      = roundUp50p(internalBase * INTERNAL_EVERY_MULTIPLIER);
      const intEveryOther = roundUp50p(internalBase * INTERNAL_EVERYOTHER_MULTIPLIER);
      const intOneoff     = roundUp50p(internalBase * INTERNAL_ONEOFF_MULTIPLIER);
      services.push({
        id: 'internalCleaning',
        name: 'Internal Window Cleaning',
        price:           intEvery,      // every visit price
        priceEveryOther: intEveryOther, // every other visit price
        priceOneoff:     intOneoff,     // one-off price
        per: 'per clean',
        type: 'internal'
      });
    }


    if (!prices.isFlat) {
      if (OFFER_GUTTER_CLEARANCE && prices.gutterClear !== null) services.push({ id: 'gutterClear', name: 'Gutter Clearance', price: prices.gutterClear, per: 'one-off', recurring: false });
      if (OFFER_GFS && prices.gfs !== null) services.push({ id: 'gfs', name: 'Gutter, Fascia & Soffit Washing', price: prices.gfs, per: 'one-off', recurring: false });
      if (prices.conRoof !== null) services.push({ id: 'conRoof', name: 'Conservatory Roof Cleaning', price: prices.conRoof, per: 'one-off', recurring: false });
    }


    // Default: window cleaning set to 4weekly, all others unanswered (null)
    services.forEach(s => {
      if (s.type === 'frequency') {
        data.selectedServices[s.id] = { ...s, selected: true, chosenFreq: 'freq1', price1: s.price, price: s.price, oneoffBase: s.oneoffBase };
      } else if (s.type === 'internal') {
        data.selectedServices[s.id] = { ...s, selected: null, chosenFreq: null, price1: s.price };
      } else {
        data.selectedServices[s.id] = { ...s, selected: null }; // null = unanswered
      }
    });


    renderCards(services);
    updateInternalCard();
  }


