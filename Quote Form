<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Get a Quote</title>
<link href="https://fonts.googleapis.com/css2?family=DM+Serif+Display:ital@0;1&family=DM+Sans:wght@300;400;500&display=swap" rel="stylesheet">
<style>
  *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }


  :root {
    --ink: #000000;
    --mid: #3a3a3a;
    --light: rgba(0,0,0,0.06);
    --bg: transparent;
    --white: #ffffff;
    --highlight: #000000;
    --highlight-light: rgba(0,0,0,0.08);
    --btn: #000000;
    --btn-hover: #333333;
    --danger: #e53e3e;
    --radius: 12px;
    --transition: 0.2s ease;
  }


  body {
    font-family: 'DM Sans', sans-serif;
    background: transparent;
    color: var(--ink);
  }


  .form-shell {
    background: var(--white);
    border-radius: 20px;
    width: 100%;
    max-width: 960px;
    margin: 0 auto;
    box-shadow: 0 4px 40px rgba(0,0,0,0.5);
    overflow: hidden;
  }


  @media (max-width: 600px) {
    .form-shell { border-radius: 0 !important; box-shadow: none !important; }
  }


  @media (min-width: 1024px) {
    .form-shell {
      min-width: 860px;
    }
    .form-header {
      padding: 2.5rem 3.5rem 0;
    }
    .form-body {
      padding: 2rem 3.5rem 2.5rem;
    }
  }


  /* Progress bar */
  .progress-bar {
    height: 4px;
    background: var(--light);
    position: relative;
  }
  .progress-fill {
    height: 100%;
    background: var(--highlight);
    transition: width 0.5s cubic-bezier(0.4,0,0.2,1);
  }


  .form-header {
    padding: 2.5rem 2.5rem 0;
  }


  .step-label {
    font-size: 0.88rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--mid);
    font-weight: 600;
    margin-bottom: 0.6rem;
  }


  .form-header h1 {
    font-family: 'DM Serif Display', serif;
    font-size: 2.0rem;
    line-height: 1.2;
    color: var(--ink);
    margin-bottom: 0.5rem;
  }


  .form-header p {
    color: var(--mid);
    font-size: 0.9rem;
    font-weight: 300;
    line-height: 1.5;
  }


  .form-body {
    padding: 2rem 2.5rem 2.5rem;
  }


  /* Pages */
  .page { display: none; animation: fadeIn 0.3s ease; }
  .page.active { display: block; }
  @keyframes fadeIn { from { opacity: 0; transform: translateY(8px); } to { opacity: 1; transform: translateY(0); } }


  /* Fields */
  .field { margin-bottom: 1.25rem; }
  .field label {
    display: block;
    font-size: 1.02rem;
    font-weight: 500;
    color: var(--ink);
    margin-bottom: 0.45rem;
    letter-spacing: 0.01em;
  }


  .field input[type="text"],
  .field input[type="email"],
  .field input[type="tel"],
  .field input[type="number"] {
    width: 100%;
    padding: 0.75rem 1rem;
    border: 1.5px solid var(--light);
    border-radius: var(--radius);
    font-family: 'DM Sans', sans-serif;
    font-size: 1.05rem;
    color: var(--ink);
    background: var(--white);
    transition: border-color var(--transition), box-shadow var(--transition);
    outline: none;
  }
  .field input:focus {
    border-color: var(--highlight);
    box-shadow: 0 0 0 3px var(--highlight-light);
  }
  .field input.error { border-color: var(--danger); }


  .error-msg {
    font-size: 0.98rem;
    color: var(--danger);
    margin-top: 0.35rem;
    display: none;
  }
  .error-msg.visible { display: block; }


  /* Marketing consent */
  .consent-group { margin-top: 1.5rem; }
  .consent-group > label {
    font-size: 1.02rem;
    font-weight: 500;
    color: var(--ink);
    display: block;
    margin-bottom: 0.75rem;
    letter-spacing: 0.01em;
  }
  .consent-options {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 0.6rem;
  }
  .consent-check {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.6rem 0.85rem;
    border: 1.5px solid var(--light);
    border-radius: var(--radius);
    cursor: pointer;
    transition: border-color var(--transition), background var(--transition);
    user-select: none;
  }
  .consent-check:hover { border-color: var(--highlight); background: var(--highlight-light); }
  .consent-check input { display: none; }
  .consent-check .check-box {
    width: 18px; height: 18px;
    border: 1.5px solid var(--light);
    border-radius: 5px;
    display: flex; align-items: center; justify-content: center;
    flex-shrink: 0;
    transition: all var(--transition);
    background: var(--white);
  }
  .consent-check input:checked ~ .check-box {
    background: var(--highlight);
    border-color: var(--highlight);
  }
  .consent-check input:checked ~ .check-box::after {
    content: '';
    display: block;
    width: 5px; height: 9px;
    border: 2px solid white;
    border-top: none; border-left: none;
    transform: rotate(45deg) translate(-1px,-1px);
  }
  .consent-check span {
    font-size: 0.93rem;
    color: var(--ink);
    font-weight: 400;
  }


  /* T&C checkbox */
  .tc-check {
    display: flex;
    align-items: flex-start;
    gap: 0.85rem;
    cursor: pointer;
    user-select: none;
    margin-top: 0.25rem;
    padding: 0.85rem 1rem;
    border: 1.5px solid var(--light);
    border-radius: var(--radius);
    transition: border-color var(--transition), background var(--transition);
  }
  .tc-check:hover { border-color: var(--highlight); }
  .tc-check input { display: none; }
  .tc-check .check-box {
    width: 24px; height: 24px;
    border: 2px solid var(--highlight);
    border-radius: 7px;
    display: flex; align-items: center; justify-content: center;
    flex-shrink: 0;
    margin-top: 0px;
    transition: all var(--transition);
    background: transparent;
  }
  .tc-check input:checked ~ .check-box {
    background: var(--highlight);
    border-color: var(--highlight);
  }
  .tc-check input:checked ~ .check-box::after {
    content: '';
    display: block;
    width: 6px; height: 11px;
    border: 2.5px solid var(--white);
    border-top: none; border-left: none;
    transform: rotate(45deg) translate(-1px,-1px);
  }
  .tc-check.error-state .check-box { border-color: var(--danger); }
  .tc-check.error-state { border-color: var(--danger); }
  .tc-check span {
    font-size: 0.93rem;
    color: var(--ink);
    line-height: 1.55;
    font-weight: 400;
  }


  /* Property type cards */
  .property-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 0.55rem;
    margin-top: 0.25rem;
  }
  .property-card {
    border: 1.5px solid var(--light);
    border-radius: 10px;
    cursor: pointer;
    text-align: center;
    transition: all 0.22s ease;
    user-select: none;
    position: relative;
    background: var(--white);
    overflow: hidden;
    padding: 0;
  }
  .prop-illustration {
    width: 100%;
    background: transparent;
    padding: 0.5rem 0.5rem 0;
    display: flex;
    align-items: center;
    justify-content: center;
    height: 120px;
    position: relative;
    overflow: hidden;
  }
  .prop-illustration::after { display: none; }
  .prop-illustration svg,
  .prop-illustration .prop-svg {
    width: auto;
    height: 110px;
    max-width: 100%;
    display: block;
    transition: transform 0.22s ease;
  }
  .prop-name {
    font-size: 0.82rem;
    font-weight: 600;
    color: var(--ink);
    letter-spacing: 0.01em;
    text-transform: none;
    padding: 0.55rem 0.4rem 0.6rem;
    line-height: 1.2;
  }
  .property-card:hover {
    border-color: var(--highlight);
    background: var(--card-hover-bg);
    transform: translateY(-2px);
    box-shadow: 0 4px 16px rgba(0,0,0,0.1);
  }
  .property-card:hover .prop-illustration svg { transform: translateY(-3px); }
  .property-card.selected {
    border-color: var(--highlight);
    background: var(--card-selected-bg);
    box-shadow: 0 0 0 1.5px var(--highlight), 0 4px 16px rgba(0,0,0,0.08);
  }
  .property-card.selected .prop-name { color: var(--highlight); }
  .property-card.selected .prop-illustration { background: var(--card-selected-bg); }
  .prop-tick {
    position: absolute;
    top: 6px; right: 7px;
    width: 17px; height: 17px;
    background: var(--highlight);
    border-radius: 50%;
    display: flex; align-items: center; justify-content: center;
    opacity: 0;
    transform: scale(0.4);
    transition: all 0.22s cubic-bezier(0.34,1.56,0.64,1);
    font-size: 1.02rem;
    color: var(--highlight-text);
    font-weight: 900;
    z-index: 2;
  }
  .property-card.selected .prop-tick { opacity: 1; transform: scale(1); }


  /* Bedroom selector */
  .bedroom-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 0.6rem;
    margin-top: 0.25rem;
  }
  .bedroom-btn {
    border: 1.5px solid var(--light);
    border-radius: var(--radius);
    padding: 0.9rem 0.5rem;
    text-align: center;
    cursor: pointer;
    font-family: 'DM Sans', sans-serif;
    font-size: 1.05rem;
    font-weight: 500;
    color: var(--ink);
    background: var(--white);
    transition: all var(--transition);
  }
  .bedroom-btn:hover { border-color: var(--highlight); background: var(--highlight-light); }
  .bedroom-btn.selected { border-color: var(--highlight); background: var(--highlight-light); color: var(--highlight); font-weight: 600; }


  /* Yes/No toggle */
  .yn-field { margin-bottom: 1.25rem; }
  .yn-field label {
    display: block;
    font-size: 1.02rem;
    font-weight: 500;
    margin-bottom: 0.5rem;
  }
  .yn-group { display: flex; gap: 0.6rem; }
  .yn-btn {
    flex: 1;
    padding: 0.75rem;
    border: 1.5px solid var(--light);
    border-radius: var(--radius);
    background: var(--white);
    font-family: 'DM Sans', sans-serif;
    font-size: 0.9rem;
    font-weight: 500;
    cursor: pointer;
    transition: all var(--transition);
    color: var(--ink);
  }
  .yn-btn:hover { border-color: var(--highlight); background: var(--highlight-light); }
  .yn-btn.selected { border-color: var(--highlight); background: var(--highlight-light); color: var(--highlight); font-weight: 600; }


  /* Buttons */
  .btn-row {
    display: flex;
    gap: 0.75rem;
    margin-top: 2rem;
    align-items: center;
  }
  .btn-back {
    background: none;
    border: none;
    font-family: 'DM Sans', sans-serif;
    font-size: 0.9rem;
    color: var(--mid);
    cursor: pointer;
    padding: 0.75rem 0;
    display: flex;
    align-items: center;
    gap: 0.4rem;
    transition: color var(--transition);
    font-weight: 500;
  }
  .btn-back:hover { color: var(--ink); }
  .btn-next {
    flex: 1;
    padding: 0.9rem 1.5rem;
    background: var(--btn);
    color: var(--btn-text);
    border: none;
    border-radius: var(--radius);
    font-family: 'DM Sans', sans-serif;
    font-size: 1.05rem;
    font-weight: 500;
    cursor: pointer;
    transition: all var(--transition);
    letter-spacing: 0.01em;
  }
  .btn-next:hover { background: var(--btn-hover); transform: translateY(-1px); box-shadow: 0 4px 16px rgba(0,0,0,0.2); }
  .btn-next:active { transform: translateY(0); }


  /* Confirmation / success */
  .confirm-box {
    text-align: center;
    padding: 1rem 0 0.5rem;
  }
  .confirm-box .icon {
    width: 56px; height: 56px;
    background: var(--highlight-light);
    border-radius: 50%;
    display: flex; align-items: center; justify-content: center;
    margin: 0 auto 1.25rem;
    font-size: 1.6rem;
  }
  .confirm-box h2 {
    font-family: 'DM Serif Display', serif;
    font-size: 1.6rem;
    margin-bottom: 0.6rem;
  }
  .confirm-box { text-align: center; }
  .confirm-box p {
    color: var(--mid);
    font-size: 0.9rem;
    line-height: 1.6;
    font-weight: 300;
  }


  .divider {
    height: 1px;
    background: var(--light);
    margin: 1.5rem 0;
  }


  .section-title {
    font-size: 1.02rem;
    font-weight: 500;
    color: var(--ink);
    margin-bottom: 0.75rem;
    letter-spacing: 0.01em;
  }


  /* Quote page */
  .quote-page-header { margin-bottom: 1.5rem; }
  .quote-intro { font-size: 0.98rem; color: var(--mid); font-weight: 300; line-height: 1.5; margin-top: 0.3rem; }


  .service-card {
    border: 2px solid rgba(0,0,0,0.15);
    border-radius: var(--radius);
    padding: 1rem 1.1rem;
    margin-bottom: 0.65rem;
    transition: all var(--transition);
    position: relative;
  }
  .service-card.selected-yes {
    border: 2px solid var(--highlight);
    background: var(--highlight-light);
  }
  .service-card.selected-no {
    opacity: 1;
    border-color: rgba(0,0,0,0.1);
    background: var(--white);
  }
  .service-card.selected-no .service-name {
    color: var(--mid);
    text-decoration: line-through;
    text-decoration-color: var(--mid);
  }
  .service-card.selected-no .service-price {
    color: var(--mid);
    text-decoration: line-through;
    text-decoration-color: var(--mid);
  }
  .service-card.selected-no .service-price .per {
    text-decoration: none;
  }
  .service-card.selected-no .freq-price-row {
    opacity: 0.35;
  }
  .service-card-top {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    gap: 0.5rem;
    margin-bottom: 0.65rem;
  }
  .service-name {
    font-size: 1.22rem;
    font-weight: 700;
    letter-spacing: 0.01em;
    color: var(--ink);
    line-height: 1.3;
  }
  .service-price {
    font-family: 'DM Serif Display', serif;
    font-size: 1.32rem;
    color: var(--highlight);
    white-space: nowrap;
    flex-shrink: 0;
  }
  .service-price .per {
    font-family: 'DM Sans', sans-serif;
    font-size: 0.92rem;
    color: var(--mid);
    font-weight: 500;
    display: block;
    text-align: right;
    margin-top: -2px;
  }
  .service-btns {
    display: flex;
    gap: 0.75rem;
    width: 100%;
  }
  .svc-btn {
    flex: 1;
    padding: 0.75rem 1rem;
    border: 2px solid rgba(0,0,0,0.18);
    border-radius: 10px;
    background: var(--white);
    font-family: 'DM Sans', sans-serif;
    font-size: 0.95rem;
    font-weight: 600;
    cursor: pointer;
    transition: all var(--transition);
    color: var(--ink);
  }
  .svc-btn:hover { border-color: var(--highlight); background: var(--highlight-light); }
  .svc-btn.active-yes { background: var(--btn); border-color: var(--btn); color: var(--btn-text); }
  .svc-btn.active-no { background: var(--light); border-color: rgba(0,0,0,0.12); color: var(--mid); }


  .quote-totals {
    background: transparent;
    border-radius: var(--radius);
    padding: 1.1rem 1.25rem;
    margin-top: 1.25rem;
  }
  .quote-total-row {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    margin-bottom: 0.5rem;
    font-size: 1.05rem;
    color: var(--mid);
  }
  .quote-total-row:last-child { margin-bottom: 0; }
  .quote-total-row.main {
    font-size: 1rem;
    font-weight: 500;
    color: var(--ink);
    padding-top: 0.6rem;
    border-top: 1px solid var(--light);
    margin-top: 0.5rem;
  }
  .quote-total-row .amt {
    font-family: 'DM Serif Display', serif;
    font-size: 1.3rem;
    color: var(--highlight);
  }
  .quote-total-row.main .amt { font-size: 1.6rem; }
  .quote-total-row.secondary {
    font-size: 0.9rem;
    font-weight: 500;
    color: var(--ink);
    padding-top: 0.5rem;
    border-top: 1px solid var(--light);
    margin-top: 0.25rem;
  }
  .quote-total-row.secondary .amt { font-size: 1.2rem; }
  .quote-note {
    font-size: 0.75rem;
    color: var(--mid);
    margin-top: 0.6rem;
    font-weight: 300;
    line-height: 1.4;
  }
  .freq-price-row {
    display: flex;
    align-items: center;
    gap: 0;
    background: transparent;
    border-radius: 10px;
    overflow: hidden;
  }
  .freq-price-block {
    flex: 1;
    text-align: center;
    padding: 0.65rem 0.5rem;
  }
  .freq-label {
    font-size: 0.92rem;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--mid);
    font-weight: 600;
    margin-bottom: 0.2rem;
  }
  .freq-amount {
    font-family: 'DM Serif Display', serif;
    font-size: 1.4rem;
    color: var(--highlight);
    line-height: 1;
  }
  .freq-per {
    font-size: 0.88rem;
    color: var(--mid);
    font-weight: 500;
    margin-top: 0.15rem;
  }
  .freq-divider {
    width: 1px;
    height: 48px;
    background: var(--light);
    flex-shrink: 0;
  }


  .loading-prices {
    text-align: center;
    padding: 2rem 0;
    color: var(--mid);
    font-size: 0.9rem;
  }
  .spinner {
    width: 28px; height: 28px;
    border: 3px solid var(--light);
    border-top-color: var(--highlight);
    border-radius: 50%;
    animation: spin 0.7s linear infinite;
    margin: 0 auto 0.75rem;
  }
  @keyframes spin { to { transform: rotate(360deg); } }
  .floor-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 0.6rem;
    margin-top: 0.25rem;
  }




  /* Textarea */
  .field textarea {
    width: 100%;
    padding: 0.75rem 1rem;
    border: 1.5px solid var(--light);
    border-radius: var(--radius);
    font-family: 'DM Sans', sans-serif;
    font-size: 1.05rem;
    color: var(--ink);
    background: var(--white);
    transition: border-color var(--transition), box-shadow var(--transition);
    outline: none;
    resize: vertical;
    min-height: 90px;
    line-height: 1.5;
  }
  .field textarea:focus {
    border-color: var(--highlight);
    box-shadow: 0 0 0 3px var(--highlight-light);
  }


  /* Access options */
  .access-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 0.6rem;
    margin-top: 0.25rem;
  }
  .access-btn {
    border: 1.5px solid var(--light);
    border-radius: var(--radius);
    padding: 0.85rem 0.5rem;
    text-align: center;
    cursor: pointer;
    font-family: 'DM Sans', sans-serif;
    font-size: 1.02rem;
    font-weight: 500;
    color: var(--ink);
    background: var(--white);
    transition: all var(--transition);
    line-height: 1.3;
  }
  .access-btn:hover { border-color: var(--highlight); background: var(--highlight-light); }
  .access-btn.selected { border-color: var(--highlight); background: var(--highlight-light); color: var(--highlight); font-weight: 600; }




  /* ===== PACKAGE UPSELL PAGE ===== */
  .pkg-section { margin-bottom: 1.8rem; }
  .pkg-section-title {
    font-size: 1rem;
    font-weight: 700;
    color: var(--ink);
    margin-bottom: 0.25rem;
  }
  .pkg-section-sub {
    font-size: 0.8rem;
    color: var(--mid);
    margin-bottom: 1rem;
    line-height: 1.5;
  }
  .pkg-options { display: flex; flex-direction: column; gap: 0.65rem; }
  .pkg-card {
    border: 1.5px solid var(--light);
    border-radius: 10px;
    padding: 0.85rem 1rem;
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    transition: all 0.18s ease;
    background: var(--white);
  }
  .pkg-card:hover { border-color: var(--highlight); background: var(--highlight-light); }
  .pkg-card.selected {
    border-color: var(--highlight);
    background: var(--highlight-light);
    box-shadow: 0 0 0 1.5px var(--highlight);
  }
  .pkg-card-left { flex: 1; }
  .pkg-card-name { font-size: 0.9rem; font-weight: 600; color: var(--ink); margin-bottom: 0.15rem; }
  .pkg-card-desc { font-size: 0.98rem; color: var(--mid); line-height: 1.4; }
  .pkg-card-price {
    text-align: right;
    flex-shrink: 0;
  }
  .pkg-card-price .pkg-price {
    font-family: 'DM Serif Display', serif;
    font-size: 1.3rem;
    color: var(--highlight);
  }
  .pkg-card-price .pkg-price-label {
    font-size: 0.7rem;
    color: var(--mid);
    display: block;
  }
  .pkg-card-price .pkg-saving {
    font-size: 0.84rem;
    color: var(--highlight);
    font-weight: 600;
  }
  .pkg-none-btn {
    width: 100%;
    background: transparent;
    border: 1.5px dashed var(--light);
    border-radius: 10px;
    padding: 0.7rem 1rem;
    font-size: 1.02rem;
    color: var(--mid);
    cursor: pointer;
    transition: all 0.18s ease;
    margin-top: 0.25rem;
    text-align: center;
  }
  .pkg-none-btn:hover { border-color: var(--mid); color: var(--ink); }
  .pkg-none-btn.selected { border-color: var(--ink); color: var(--ink); font-weight: 600; }


  /* Top back button */
  .top-back-btn {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    background: var(--light);
    border: none;
    border-radius: 8px;
    padding: 0.45rem 0.85rem 0.45rem 0.65rem;
    font-family: 'DM Sans', sans-serif;
    font-size: 1.02rem;
    font-weight: 600;
    color: var(--ink);
    cursor: pointer;
    transition: background 0.18s ease, color 0.18s ease;
    letter-spacing: 0.01em;
    margin-bottom: 1rem;
  }
  .top-back-btn:hover { background: var(--highlight-light); color: var(--highlight); }
  .top-back-btn svg { width: 14px; height: 14px; flex-shrink: 0; }


  /* ===== MOBILE ===== */
  @media (max-width: 600px) {
    body {
      padding: 0;
      background: var(--white);
    }
    .form-shell {
      border-radius: 0;
      box-shadow: none;
      min-height: 100dvh;
    }
    .form-header {
      padding: 1.5rem 1.25rem 0;
    }
    .form-header h1 {
      font-size: 1.55rem;
    }
    .form-body {
      padding: 1.25rem 1.25rem 2rem;
    }


    /* Property grid: 2 cols but tighter */
    .property-grid {
      grid-template-columns: 1fr 1fr;
      gap: 0.45rem;
    }
    .prop-illustration {
      height: 90px;
    }
    .prop-illustration svg,
    .prop-illustration .prop-svg {
      height: 82px;
    }
    .prop-name {
      font-size: 0.63rem;
      padding: 0.45rem 0.3rem 0.5rem;
    }


    /* Bedrooms: 3 cols → 3 cols but larger tap targets */
    .bedroom-grid {
      grid-template-columns: repeat(3, 1fr);
      gap: 0.5rem;
    }
    .bedroom-btn {
      padding: 1rem 0.5rem;
      font-size: 1rem;
    }


    /* Floor grid */
    .floor-grid {
      grid-template-columns: repeat(2, 1fr);
    }


    /* Access: 3 cols → 1 col stack */
    .access-grid {
      grid-template-columns: 1fr;
    }
    .access-btn {
      padding: 0.85rem 1rem;
      text-align: left;
    }


    /* Consent: 2 cols → 1 col */
    .consent-options {
      grid-template-columns: 1fr;
    }


    /* Freq price row: shrink text on small screens */
    .freq-amount {
      font-size: 1.22rem;
    }
    .freq-label {
      font-size: 0.64rem;
    }
    .freq-per {
      font-size: 0.64rem;
    }
    .freq-price-block {
      padding: 0.55rem 0.25rem;
    }


    /* Service card buttons: wrap if needed */
    .service-btns {
      flex-wrap: wrap;
    }
    .svc-btn {
      font-size: 0.88rem;
      padding: 0.7rem 0.5rem;
    }


    /* Quote totals */
    .quote-total-row.main .amt { font-size: 1.3rem; }
    .quote-total-row .amt { font-size: 1.1rem; }


    /* Btn row: stack back + next vertically on very small */
    .btn-row {
      flex-direction: column-reverse;
      gap: 0.5rem;
      margin-top: 1.5rem;
    }
    .btn-back {
      width: 100%;
      justify-content: center;
      padding: 0.6rem 0;
    }
    .btn-next {
      width: 100%;
      padding: 1rem 1.5rem;
      font-size: 1rem;
    }


    /* Package cards: stack price below name on very narrow */
    .pkg-card {
      flex-wrap: wrap;
      gap: 0.5rem;
    }
    .pkg-card-price {
      width: 100%;
      text-align: left;
      display: flex;
      align-items: baseline;
      gap: 0.5rem;
      padding-top: 0.4rem;
      border-top: 1px solid var(--light);
    }
    .pkg-card-price .pkg-price-label {
      display: inline;
    }
    .pkg-card-price .pkg-saving {
      margin-left: auto;
    }


    /* Upsell pricing notice rows */
    #pkgPricingRows > div {
      flex-direction: column;
      gap: 0.3rem;
    }


    /* YN buttons: bigger tap target */
    .yn-btn {
      padding: 0.9rem;
      font-size: 1.05rem;
    }


    /* Confirm box */
    .confirm-box {
      padding: 0.5rem 0;
    }


    /* Success button full width */
    .confirm-box a.btn-next {
      display: block !important;
      width: 100%;
      box-sizing: border-box;
    }
  }
</style>
<script>
  (function() {
    var boxBg  = ('{{brandboards.logo_background_colour}}'.trim()) || '#ffffff';
    var btnCol = ('{{brandboards.button_colour}}'.trim())          || '#000000';
    var hlCol  = ('{{brandboards.email_background_colour}}'.trim())|| '#000000';


    // Parse hex to rgb components
    function hexToRgb(hex) {
      hex = hex.replace('#','');
      if (hex.length === 3) hex = hex.split('').map(function(c){return c+c;}).join('');
      return [parseInt(hex.substr(0,2),16), parseInt(hex.substr(2,2),16), parseInt(hex.substr(4,2),16)];
    }


    // Relative luminance per WCAG
    function luminance(hex) {
      var rgb = hexToRgb(hex).map(function(v) {
        v = v / 255;
        return v <= 0.03928 ? v / 12.92 : Math.pow((v + 0.055) / 1.055, 2.4);
      });
      return 0.2126 * rgb[0] + 0.7152 * rgb[1] + 0.0722 * rgb[2];
    }


    // Return black or white depending on which contrasts better against bg
    function contrastText(bg) {
      return luminance(bg) > 0.179 ? '#000000' : '#ffffff';
    }


    // Lighten a hex colour toward white by amount (0-1)
    function lightenHex(hex, amount) {
      var c = hexToRgb(hex);
      c = c.map(function(v){ return Math.min(255, Math.round(v + (255 - v) * amount)); });
      return '#' + c.map(function(x){return x.toString(16).padStart(2,'0');}).join('');
    }


    // Darken a hex colour toward black by amount (0-1)
    function darkenHex(hex, amount) {
      var c = hexToRgb(hex);
      c = c.map(function(v){ return Math.max(0, Math.round(v * (1 - amount))); });
      return '#' + c.map(function(x){return x.toString(16).padStart(2,'0');}).join('');
    }


    // Slightly contrast from a background (darken if light, lighten if dark)
    function subtleContrast(hex, amount) {
      return luminance(hex) > 0.179 ? darkenHex(hex, amount) : lightenHex(hex, amount);
    }


    var r = document.documentElement;


    // Box & text
    r.style.setProperty('--white', boxBg);
    r.style.setProperty('--ink',   contrastText(boxBg));
    r.style.setProperty('--mid',   luminance(boxBg) > 0.179 ? 'rgba(0,0,0,0.45)' : 'rgba(255,255,255,0.5)');
    r.style.setProperty('--light', luminance(boxBg) > 0.179 ? 'rgba(0,0,0,0.06)' : 'rgba(255,255,255,0.08)');


    // Property card selected state — subtle contrast from box background
    r.style.setProperty('--card-selected-bg', subtleContrast(boxBg, 0.08));
    r.style.setProperty('--card-hover-bg',    subtleContrast(boxBg, 0.04));


    // Buttons
    r.style.setProperty('--btn',      btnCol);
    r.style.setProperty('--btn-text', contrastText(btnCol));
    r.style.setProperty('--btn-hover', luminance(btnCol) > 0.179 ? darkenHex(btnCol, 0.12) : lightenHex(btnCol, 0.2));


    // Highlights
    r.style.setProperty('--highlight',       hlCol);
    r.style.setProperty('--highlight-text',  contrastText(hlCol));
    r.style.setProperty('--highlight-light', luminance(boxBg) > 0.179 ? darkenHex(boxBg, 0.06) : lightenHex(boxBg, 0.08));


    // SVG illustration colours from HL custom values
    var svgPrimary   = ('{{custom_values.illustration_primary_colour}}'.trim())   || hlCol;
    var svgSecondary = ('{{custom_values.illustration_secondary_colour}}'.trim()) || darkenHex(btnCol, 0.25);
    r.style.setProperty('--svg-primary',   svgPrimary);
    r.style.setProperty('--svg-secondary', svgSecondary);
    // Window colour: always contrasts against the primary building colour
    r.style.setProperty('--svg-window', contrastText(svgPrimary));
  })();
</script>
