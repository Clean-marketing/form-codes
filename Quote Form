      <button class="top-back-btn" onclick="goBack(2)"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="15 18 9 12 15 6"/></svg>Back</button>
      <div class="step-label">Business Quote</div>
      <h1>Your business details</h1>
      <p>Tell us about your business and what services you're interested in — a member of our team will be in touch with a personalised quote.</p>
    </div>
    <div class="form-body">
      <div class="field">
        <label for="businessName">Business name</label>
        <input type="text" id="businessName" placeholder="e.g. Acme Ltd">
        <div class="error-msg" id="err-businessName">Please enter your business name.</div>
      </div>
      <div class="field">
        <label for="bizStreetAddress">Street address</label>
        <input type="text" id="bizStreetAddress" placeholder="e.g. 12 High Street">
        <div class="error-msg" id="err-bizStreetAddress">Please enter your street address.</div>
      </div>
      <div class="field">
        <label for="bizTown">Town</label>
        <input type="text" id="bizTown" placeholder="e.g. Trowbridge">
        <div class="error-msg" id="err-bizTown">Please enter your town.</div>
      </div>
      <div class="field">
        <label for="bizPostcode">Postcode</label>
        <input type="text" id="bizPostcode" placeholder="e.g. BA14 8AA">
        <div class="error-msg" id="err-bizPostcode">Please enter your postcode.</div>
      </div>


