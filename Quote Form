  function getPrice(pricing) {
    const pt   = data.propertyType;
    const beds = data.bedrooms === '6+' ? '5' : data.bedrooms; // fallback 6+ to 5
    const hasExt = data.extension === 'yes';
    const hasCon = data.conservatory === 'yes';


    let row;
    if (pt === 'flat') {
      const floor = data.flatFloor === 'ground' ? 'ground' : data.flatFloor === '1st' ? '1st' : '2nd';
      row = pricing.flat[floor][beds];
      if (!row) return null;
      return {
        freq1: row.freq1,
        freq2: row.freq2,
        gutterClear: null, gfs: null, // flats don't get gutter/GFS
        conRoof: null,
        isFlat: true
      };
    }


    row = pricing[pt] && pricing[pt][beds];
    if (!row) return null;


    const freq1 = row.freq1 + (hasExt ? row.addExt : 0) + (hasCon ? row.addCon : 0);
    const freq2 = row.freq2 + (hasExt ? row.addExt : 0) + (hasCon ? row.addCon : 0);
    const gutterClear = row.gutterClear + (hasExt ? row.extClear : 0) + (hasCon ? row.conClear : 0);
    const gfs = row.gfs + (hasExt ? row.extGfs : 0) + (hasCon ? row.conGfs : 0);


    let conRoof = null;
    if (data.conservatory === 'yes') {
      if (CON_ROOF_MODE === 'fixed price' && row.conRoof > 0) {
        conRoof = row.conRoof;
      } else if (CON_ROOF_MODE === 'per panel' && data.conservatoryRoofQuote === 'yes' && data.roofPanels) {
        const panels = parseInt(data.roofPanels);
        conRoof = Math.max(CON_ROOF_MIN, panels * CON_ROOF_PER_PANEL);
      }
      // CON_ROOF_MODE === 'no' → conRoof stays null
    }


    const freq3 = row.freq3 ? row.freq3 + (hasExt ? row.addExt : 0) + (hasCon ? row.addCon : 0) : null;
    // Raw base prices (before extensions) used for one-off/internal multiplier base
    const rawFreq1 = row.freq1;
    const rawFreq2 = row.freq2;
    const rawFreq3 = row.freq3 || null;
    const addOns   = (hasExt ? row.addExt : 0) + (hasCon ? row.addCon : 0);


    return { freq1, freq2, freq3, gutterClear, gfs, conRoof, isFlat: false, rawFreq1, rawFreq2, rawFreq3, addOns };
  }


