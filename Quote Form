  function updateTotals() {
    const svcs = Object.values(data.selectedServices).filter(s => s.selected === true);
    const winSvc = data.selectedServices['windowCleaning'];
    const intSvc2 = data.selectedServices['internalCleaning'];
    const extIsRegular    = winSvc  && winSvc.selected  && winSvc.chosenFreq !== 'oneoff';
    const extIsOneOff     = winSvc  && winSvc.selected  && winSvc.chosenFreq === 'oneoff';
    const intIsEvery      = intSvc2 && intSvc2.selected === true && intSvc2.chosenFreq === 'every';
    const intIsEveryOther = intSvc2 && intSvc2.selected === true && intSvc2.chosenFreq === 'everyother';


    // Determine if front-only affects first clean too
    // Only applies if: front-only is active, regular clean selected, no additional services booked
    const hasAdditionalServices = svcs.some(s => s.id !== 'windowCleaning' && s.id !== 'internalCleaning');
    const frontOnlyGoesForward = data.frontOnlyApplies && data.frontOnlyPrice && !extIsOneOff;
    const frontOnlyFirstClean  = frontOnlyGoesForward && !hasAdditionalServices;


    // First clean: front-only price if no extras, otherwise full price (access arranged)
    const firstCleanWinPrice = (frontOnlyFirstClean && winSvc?.selected) ? data.frontOnlyPrice : (winSvc ? winSvc.price : 0);
    let firstClean = svcs.reduce((sum, s) => {
      if (s.id === 'windowCleaning') return sum + firstCleanWinPrice;
      return sum + s.price;
    }, 0);


    // On the post-booking upsell page only: gutter/conRoof services were already paid for
    // as one-offs in the original booking. Recalculate their first-clean contribution based
    // on what packages/one-offs are selected on the upsell page.
    const onUpsellPage = document.getElementById('page5b')?.classList.contains('active');
    if (onUpsellPage) {
      const gutterSvcFC   = data.selectedServices['gutterClear'];
      const gfsSvcFC      = data.selectedServices['gfs'];
      const conRoofSvcFC  = data.selectedServices['conRoof'];


      // Remove original service prices (already included by svcs.reduce above)
      if (gutterSvcFC?.selected === true)  firstClean -= (gutterSvcFC.price  || 0);
      if (gfsSvcFC?.selected    === true)  firstClean -= (gfsSvcFC.price     || 0);
      if (conRoofSvcFC?.selected === true) firstClean -= (conRoofSvcFC.price || 0);


      // Re-add based on package/one-off selections
      if (selectedPackages.gutterPackage) {
        const pkgId = selectedPackages.gutterPackage.id;
        const coversClear = ['yearly-clear','6monthly-clear','yearly-combined'].includes(pkgId);
        const coversGfs   = ['yearly-gfs','yearly-combined'].includes(pkgId);
        if (coversClear && gutterSvcFC) firstClean += gutterSvcFC.price || 0;
