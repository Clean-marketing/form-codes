  // Returns the combo discount amount (window clean price off first clean if both gutters booked)
  function getComboDiscount() {
    if (!FREE_WINDOW_COMBO) return 0;
    const gutterSvc  = data.selectedServices['gutterClear'];
    const gfsSvc     = data.selectedServices['gfs'];
    const winSvc     = data.selectedServices['windowCleaning'];
    const bothBooked = gutterSvc?.selected === true && gfsSvc?.selected === true;
    if (!bothBooked || !winSvc?.selected) return 0;
    return winSvc.price;
  }


  // Build the 5 named service data points for webhook payloads
  function buildServiceDataPoints() {
    const winSvc     = data.selectedServices['windowCleaning'];
    const intSvc     = data.selectedServices['internalCleaning'];
    const gutterSvc  = data.selectedServices['gutterClear'];
    const gfsSvc     = data.selectedServices['gfs'];
    const conRoofSvc = data.selectedServices['conRoof'];


    // External Window Cleaning Service
    let externalWindowCleaningService = 'No Thanks';
    if (winSvc?.selected) {
      if (winSvc.chosenFreq === 'oneoff') {
        externalWindowCleaningService = 'One-Off Window Cleaning';
      } else {
        const freqIdx = parseInt(winSvc.chosenFreq.replace('freq', '')) - 1;
        const freqLabel = FREQ_LABELS[freqIdx] || winSvc.chosenFreq;
        externalWindowCleaningService = freqLabel + ' Window Cleaning';
      }
    }


    // Internal Window Cleaning Service
    let internalWindowCleaningService = 'No Thanks';
    if (intSvc?.selected) {
      const map = { every: 'Internal Every Time', everyother: 'Internal Every Other Time', oneoff: 'Internal One-Off' };
      internalWindowCleaningService = map[intSvc.chosenFreq] || intSvc.chosenFreq;
    }


    // One-off services
    const gutterClearanceService             = gutterSvc  ? (gutterSvc.selected  ? 'Yes Please' : 'No Thanks') : null;
    const gutterFasciaSoffitWashingService   = gfsSvc     ? (gfsSvc.selected     ? 'Yes Please' : 'No Thanks') : null;
    const conservatoryRoofCleaningService    = conRoofSvc ? (conRoofSvc.selected ? 'Yes Please' : 'No Thanks') : null;


    return {
      externalWindowCleaningService,
      internalWindowCleaningService,
      gutterClearanceService,
      gutterFasciaSoffitWashingService,
      conservatoryRoofCleaningService,
    };
  }




  function buildPricingSummary() {
    var win   = data.selectedServices['windowCleaning'];
    var intl  = data.selectedServices['internalCleaning'];
    var gut   = data.selectedServices['gutterClear'];
    var gfs   = data.selectedServices['gfs'];
    var roof  = data.selectedServices['conRoof'];
    var combo = getComboDiscount();


    // First clean = all selected service prices minus combo discount
    var firstClean = Math.max(0, Object.values(data.selectedServices)
      .filter(function(s){ return s.selected === true; })
      .reduce(function(sum, s){ return sum + s.price; }, 0) - combo);


    // Regular (ongoing) clean = window + internal (recurring only)
    var regularClean = 0;
    var winRegular = null;
    var annualValue = 0;


    // Use pre-calculated cleansPerYear stored on the service object at card-build time
    var cleansPerYear = 0;
    if (win && win.chosenFreq && win.chosenFreq !== 'oneoff') {
      var freqIdx = parseInt(win.chosenFreq.replace('freq', ''), 10) - 1;
      if (freqIdx >= 0 && win.freqCleansPerYear && win.freqCleansPerYear[freqIdx] > 0) {
        cleansPerYear = win.freqCleansPerYear[freqIdx];
      }
    }


    if (win && win.selected) {
      var price = Number((data.frontOnlyApplies && data.frontOnlyPrice) ? data.frontOnlyPrice : win.price) || 0;
      winRegular = price;
      if (win.chosenFreq !== 'oneoff' && cleansPerYear > 0) {
        regularClean += price;
        annualValue += price * cleansPerYear;
      }
    }
    if (intl && intl.selected && intl.chosenFreq !== 'oneoff') {
      var intlPrice = Number(intl.price) || 0;
      // Only add to regularClean if every time — every other time has its own everyOtherTimePrice field
      if (intl.chosenFreq === 'every') regularClean += intlPrice;
      var intlCleansPerYear = intl.chosenFreq === 'everyother' ? cleansPerYear / 2 : cleansPerYear;
      if (intlCleansPerYear > 0) annualValue += intlPrice * intlCleansPerYear;
    }
    annualValue = isFinite(annualValue) && annualValue > 0 ? Math.round(annualValue * 100) / 100 : 0;


    return {
      firstCleanTotal:   parseFloat(firstClean.toFixed(2)),
      regularCleanTotal: parseFloat(regularClean.toFixed(2)),
      estimatedAnnualValue: parseFloat(annualValue.toFixed(2)),
      estimatedYearlyValue: parseFloat(annualValue.toFixed(2)),
      comboDiscount:     combo > 0 ? combo : null,
      everyOtherTimePrice: (win && win.selected && win.chosenFreq !== 'oneoff' && intl && intl.selected && intl.chosenFreq === 'everyother')
        ? parseFloat(((Number(winRegular) || 0) + (Number(intl.price) || 0)).toFixed(2))
        : null,
      windowCleaning: win && win.selected ? {
        frequency: win.chosenFreq === 'oneoff' ? 'One-Off' : ((FREQ_LABELS[parseInt(win.chosenFreq.replace('freq','')) - 1] || win.chosenFreq) + (data.frontOnlyApplies ? ' Front Only' : '')),
        regularPrice: winRegular,
        firstCleanPrice: winRegular
      } : null,
      internalWindowCleaning: intl && intl.selected ? {
        type: intl.chosenFreq,
        price: intl.price,
        recurring: intl.chosenFreq !== 'oneoff'
      } : null,
      gutterClearance:       gut  && gut.selected  ? gut.price  : null,
      gutterFasciaSoffit:    gfs  && gfs.selected  ? gfs.price  : null,
      conservatoryRoofClean: roof && roof.selected ? roof.price : null
    };
  }


  function buildServicesSummary() {
    var parts = [];
    var win = data.selectedServices['windowCleaning'];
    var intl = data.selectedServices['internalCleaning'];
    var gutter = data.selectedServices['gutterClear'];
    var gfs = data.selectedServices['gfs'];
