  <!-- PAGE 3: Bedrooms + extras -->
  <div id="page3" class="page">
    <div class="form-header">
      <button class="top-back-btn" onclick="goBack(2)"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="15 18 9 12 15 6"/></svg>Back</button>
      <div class="step-label">Step 3 of 3</div>
      <h1>Property details</h1>
      <p>Almost there — just a few more details about your home.</p>
    </div>
    <div class="form-body">


      <div class="section-title">Number of bedrooms</div>
      <div class="bedroom-grid" id="bedroomGrid">
        <button class="bedroom-btn" onclick="selectBedroom(this,'1')">1</button>
        <button class="bedroom-btn" onclick="selectBedroom(this,'2')">2</button>
        <button class="bedroom-btn" onclick="selectBedroom(this,'3')">3</button>
        <button class="bedroom-btn" onclick="selectBedroom(this,'4')">4</button>
        <button class="bedroom-btn" onclick="selectBedroom(this,'5')">5</button>
        <button class="bedroom-btn" onclick="selectBedroom(this,'6+')">6+</button>
      </div>
      <div class="error-msg" id="err-bedrooms" style="margin-top:0.6rem">Please select the number of bedrooms.</div>


      <div class="divider"></div>


      <div class="yn-field">
        <label>Do you have an extension?</label>
        <div class="yn-group">
          <button class="yn-btn" onclick="selectYN(this,'extension','yes')">Yes</button>
          <button class="yn-btn" onclick="selectYN(this,'extension','no')">No</button>
        </div>
        <div class="error-msg" id="err-extension">Please select an option.</div>
      </div>


      <div class="yn-field">
        <label>Do you have a conservatory?</label>
        <div class="yn-group">
          <button class="yn-btn" onclick="selectYN(this,'conservatory','yes'); showConservatoryUpsell(true)">Yes</button>
          <button class="yn-btn" onclick="selectYN(this,'conservatory','no'); showConservatoryUpsell(false)">No</button>
        </div>
        <div class="error-msg" id="err-conservatory">Please select an option.</div>
      </div>


      <div id="conservatoryUpsell" style="display:none">
        <div class="yn-field">
          <label>Would you also like a quote for your conservatory roof to be cleaned?</label>
          <div class="yn-group">
            <button class="yn-btn" onclick="selectYN(this,'conservatoryRoofQuote','yes'); showRoofPanels(true)">Yes</button>
            <button class="yn-btn" onclick="selectYN(this,'conservatoryRoofQuote','no'); showRoofPanels(false)">No</button>
          </div>
          <div class="error-msg" id="err-conservatoryRoofQuote">Please select an option.</div>
        </div>


        <div id="roofPanelsField" style="display:none">
          <div class="field">
            <label for="roofPanelCount">How many roof panels does it have?</label>
            <input type="number" id="roofPanelCount" min="1" max="999" placeholder="e.g. 12" oninput="data.roofPanels = this.value.trim(); clearError('err-roofPanels')">
            <div class="error-msg" id="err-roofPanels">Please enter the number of roof panels.</div>
          </div>
        </div>
      </div>


      <div class="btn-row">
        <button class="btn-back" onclick="goBack(2)">← Back</button>
        <button class="btn-next" onclick="goToCustom()">Continue →</button>
      </div>
    </div>
  </div>


