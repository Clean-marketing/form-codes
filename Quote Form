    <div class="form-header">
      <button class="top-back-btn" onclick="goBack(2)"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="15 18 9 12 15 6"/></svg>Back</button>
      <div class="step-label">Personalised Quote</div>
      <h1>Your property address</h1>
      <p>Due to the size or nature of your property, a member of our team will be in touch to arrange a personalised quote.</p>
    </div>
    <div class="form-body">
      <div class="field">
        <label for="largeStreetAddress">Street address</label>
        <input type="text" id="largeStreetAddress" placeholder="e.g. 12 Maple Street">
        <div class="error-msg" id="err-largeStreetAddress">Please enter your street address.</div>
      </div>
      <div class="field">
        <label for="largeTown">Town</label>
        <input type="text" id="largeTown" placeholder="e.g. Trowbridge">
        <div class="error-msg" id="err-largeTown">Please enter your town.</div>
      </div>
      <div class="field">
        <label for="largePostcode">Postcode</label>
        <input type="text" id="largePostcode" placeholder="e.g. BA14 8AA">
        <div class="error-msg" id="err-largePostcode">Please enter your postcode.</div>
      </div>
      <div class="btn-row">
        <button class="btn-back" onclick="goBackFromPage4()">← Back</button>
        <button class="btn-next" onclick="submitLarge()">Submit →</button>
      </div>
    </div>
  </div>


