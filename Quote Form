    if (win && win.selected) {
      if (win.chosenFreq === 'oneoff') {
        parts.push('One-Off Window Cleaning');
      } else {
        var idx = parseInt(win.chosenFreq.replace('freq','')) - 1;
        parts.push((FREQ_LABELS[idx] || win.chosenFreq) + (data.frontOnlyApplies ? ' Front Only' : '') + ' Window Cleaning');
      }
    }


    // Internal window cleaning
    if (intl && intl.selected) {
      var intlMap = { every: 'Internal Window Cleaning (Every Time)', everyother: 'Internal Window Cleaning (Every Other Time)', oneoff: 'One-Off Internal Window Cleaning' };
      parts.push(intlMap[intl.chosenFreq] || 'Internal Window Cleaning');
    }


    // Gutter clearance — from page 8 OR package/one-off
    var hasGutterClear = (gutter && gutter.selected)
      || selectedPackages.gutterOneOff === 'clear'
      || (selectedPackages.gutterPackage && (selectedPackages.gutterPackage.id === 'yearly-combined' || selectedPackages.gutterPackage.id === 'yearly-clear' || selectedPackages.gutterPackage.id === '6monthly-clear'));
    if (hasGutterClear) parts.push('Gutter Clearance');


    // Gutter fascia & soffit — from page 8 OR package/one-off
    var hasGfs = (gfs && gfs.selected)
      || selectedPackages.gutterOneOff === 'gfs'
      || (selectedPackages.gutterPackage && (selectedPackages.gutterPackage.id === 'yearly-combined' || selectedPackages.gutterPackage.id === 'yearly-gfs'));
    if (hasGfs) parts.push('Gutter, Fascia & Soffit Washing');


    // Conservatory roof — from page 8 OR package/one-off
    var hasRoof = (roof && roof.selected)
      || selectedPackages.conRoofOneOff
      || selectedPackages.conRoofPackage;
    if (hasRoof) parts.push('Conservatory Roof Cleaning');


    return parts.map(function(p){ return '- ' + p; }).join('\n') || 'None selected';
  }


  // Builds pricing summary including package upsell additions
  function buildFullPricingSummary() {
    var base = buildPricingSummary();


    // Add package prices to first clean
    var pkgFirstClean = base.firstCleanTotal;
    if (selectedPackages.gutterPackage) {
      var gutterSvc = data.selectedServices['gutterClear'];
      var gfsSvc    = data.selectedServices['gfs'];
      if (!gutterSvc || !gutterSvc.selected) pkgFirstClean += (gutterSvc ? gutterSvc.price : 0);
      if (!gfsSvc    || !gfsSvc.selected)    pkgFirstClean += (gfsSvc    ? gfsSvc.price    : 0);
    }
    if (selectedPackages.conRoofPackage) {
      var roofSvc = data.selectedServices['conRoof'];
      if (!roofSvc || !roofSvc.selected) pkgFirstClean += (roofSvc ? roofSvc.price : 0);
    }
    if (selectedPackages.gutterOneOff === 'clear') {
      var gutterSvc = data.selectedServices['gutterClear'];
      if (gutterSvc && !gutterSvc.selected) pkgFirstClean += gutterSvc.price;
    }
    if (selectedPackages.gutterOneOff === 'gfs') {
      var gfsSvc = data.selectedServices['gfs'];
      if (gfsSvc && !gfsSvc.selected) pkgFirstClean += gfsSvc.price;
    }
    if (selectedPackages.conRoofOneOff) {
      var roofSvc = data.selectedServices['conRoof'];
      if (roofSvc && !roofSvc.selected) pkgFirstClean += roofSvc.price;
    }


    base.firstCleanTotal = parseFloat(pkgFirstClean.toFixed(2));
    base.gutterPackage       = selectedPackages.gutterPackage   ? selectedPackages.gutterPackage.name   : null;
    base.gutterPackagePrice  = selectedPackages.gutterPackage   ? selectedPackages.gutterPackage.price  : null;
    base.conRoofPackage      = selectedPackages.conRoofPackage  ? selectedPackages.conRoofPackage.name  : null;
    base.conRoofPackagePrice = selectedPackages.conRoofPackage  ? selectedPackages.conRoofPackage.price : null;
    base.gutterOneOff        = selectedPackages.gutterOneOff    || null;
    base.conRoofOneOff       = selectedPackages.conRoofOneOff   ? true : null;


    // Add package recurring annual values
    var pkgAnnual = base.estimatedAnnualValue || 0;
    if (selectedPackages.gutterPackage) {
      var gpId = selectedPackages.gutterPackage.id;
      var gpPrice = selectedPackages.gutterPackage.price || 0;
      if (gpId === 'yearly-combined' || gpId === 'yearly-clear' || gpId === 'yearly-gfs') pkgAnnual += gpPrice * 1;
      else if (gpId === '6monthly-clear') pkgAnnual += gpPrice * 2;
    }
    if (selectedPackages.conRoofPackage) {
      var crId = selectedPackages.conRoofPackage.id;
      var crPrice = selectedPackages.conRoofPackage.price || 0;
      if (crId === '3monthly') pkgAnnual += crPrice * 4;
      else if (crId === '6monthly') pkgAnnual += crPrice * 2;
    }
    base.estimatedAnnualValue = parseFloat(pkgAnnual.toFixed(2));
    return base;
  }


